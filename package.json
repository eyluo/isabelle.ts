{
  "name": "isabelle.ts",
  "version": "1.0.0",
  "description": "mediamigos discord bot (now in typescript!)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc -w",
    "deploy": "tsc && node dist/deploy-commands.js",
    "clean": "rm -rf dist coverage",
    "test": "tsc && vitest run",
    "test:watch": "tsc && vitest",
    "test:coverage": "tsc && vitest run --coverage"
  },
  "dependencies": {
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "",
  "license": "ISC"
}
